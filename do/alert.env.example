# Copy to /etc/vps-do/alert.env (root-owned, mode 600).
# Create a dedicated Telegram bot with @BotFather, send it a message from
# your own account, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates — or use tg_send.py's
# error output while iterating. Never commit the real file anywhere.
ALERT_BOT_TOKEN=123456:replace-with-your-bot-token
ALERT_CHAT_ID=replace-with-your-chat-id
